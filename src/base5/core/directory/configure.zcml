<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:browser="http://namespaces.zope.org/browser"
  xmlns:plone="http://namespaces.plone.org/plone"
  i18n_domain="base">

  <utility
    name="user_properties"
    factory="base5.core.directory.indexers.UserPropertiesSoupCatalogFactory"
    provides="souper.interfaces.ICatalogFactory"
    />

  <utility
    name="ldap_groups"
    factory=".indexers.GroupsSoupCatalogFactory"
    provides="souper.interfaces.ICatalogFactory"
    />

  <utility
    name="user_news_searches"
    factory=".indexers.UserNewsSearchSoupCatalog"
    provides="souper.interfaces.ICatalogFactory"
    />

  <utility
    name="users_delete_local_roles"
    factory=".indexers.UsersDeleteLocalRoles"
    provides="souper.interfaces.ICatalogFactory"
    />

  <utility
    name="users_portrait"
    factory=".indexers.UsersDeleteLocalRoles"
    provides="souper.interfaces.ICatalogFactory"
    />

  <subscriber
    for="Products.PluggableAuthService.interfaces.authservice.IPropertiedUser
         Products.PluggableAuthService.interfaces.events.IPrincipalCreatedEvent"
    handler=".subscribers.create_user_hook"
    />

  <subscriber
    for="Products.PluggableAuthService.interfaces.authservice.IPropertiedUser
         Products.PluggableAuthService.interfaces.events.IPropertiesUpdatedEvent"
    handler=".subscribers.update_user_properties_hook"
    />

  <subscriber
    for="Products.PluggableAuthService.interfaces.events.IUserLoggedInEvent"
    handler=".subscribers.UpdateUserPropertiesOnLogin"
    />

  <subscriber
    for="Products.PluggableAuthService.interfaces.events.IUserLoggedInEvent"
    handler=".subscribers.UpdateNotifyBirthday"
    />

  <subscriber
    for="Products.PlonePAS.interfaces.events.IUserInitialLoginInEvent"
    handler=".subscribers.UpdateUserPropertiesOnFirstLogin"
    />

  <browser:page
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    name="activateomega13"
    permission="zope2.Public"
    class=".omega13.ActivateOmega13"
    />

  <browser:page
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    name="syncldapgroups"
    permission="zope2.Public"
    class=".views.SyncLDAPGroups"
    />

</configure>
